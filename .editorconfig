root = true

# Defaults
[*]
charset = utf-8
indent_style = space
indent_size = 2
max_line_length = 100
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_size = 4
max_line_length = 88

[*.{lua,luau,json,jsonc,toml,yaml,yml,kdl,ps1,psd1,psm1}]
indent_size = 2

[*.{sh,bash,mksh,bats,zsh}]
binary_next_line = false
function_next_line = false
simplify = false
space_redirects = false
switch_case_indent = true

[{.bashrc,.bash_profile,.bash_logout,.brushrc,.zshrc,.zshenv,.zprofile,.zlogin,.zlogout}]
binary_next_line = false
function_next_line = false
simplify = false
space_redirects = false
switch_case_indent = true

[*.{bat,cmd}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
max_line_length = 100

[{.gitignore,.gitattributes,.gitmodules,.git-blame-ignore-revs,.mailmap,COMMIT_EDITMSG,MERGE_MSG,TAG_EDITMSG}]
indent_size = 2

[{Makefile,Makefile.am,Makefile.in,*.mk}]
indent_style = tab
