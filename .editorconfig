root = true

# Default rules for all files
[*]
charset = utf-8
indent_style = space
indent_size = 2
max_line_length = 100
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Python
[*.py]
charset = utf-8-bom
indent_size = 4
max_line_length = 88

# Shell scripts
[*.{sh,bash,zsh}]
charset = utf-8
indent_size = 2

[*.{bat,cmd}]
charset = utf-8
end_of_line = crlf

[*.{ps1}]
charset = utf-8

# Markdown
[*.md]
charset = utf-8-bom
trim_trailing_whitespace = false
max_line_length = off

# Git-related files
[{.gitignore,.gitattributes,.gitmodules,.git-blame-ignore-revs,.mailmap,COMMIT_EDITMSG,MERGE_MSG,TAG_EDITMSG}]
charset = utf-8-bom
indent_size = 2

# Makefile
[{Makefile,Makefile.am,Makefile.in,*.mk}]
charset = utf-8
indent_style = tab
