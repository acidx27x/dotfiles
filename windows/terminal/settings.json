                    "calt": 1,
                    "cv01": 1,
                    "cv02": 1,
                    "cv13": 1,
                    "cv14": 1,
                    "cv16": 1,
                    "cv18": 1,
                    "cv29": 1,
                    "cv30": 1,
                    "ss01": 1,
                    "ss04": 1,
                    "ss05": 1,
                    "ss06": 1,
                    "ss10": 1
                },
                "size": 14,
                "weight": "medium"
            },
            "historySize": 10000,
            "opacity": 100,
            "padding": "10, 8, 10, 8",
            "startingDirectory": "%USERPROFILE%",
            "suppressApplicationTitle": false,
            "useAcrylic": true
        },
