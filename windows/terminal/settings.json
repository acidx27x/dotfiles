{
    "$help": "https://aka.ms/terminal-documentation",
    "$schema": "https://aka.ms/terminal-profiles-schema",
    "actions":
    [
        {
            "command":
            {
                "action": "copy",
                "singleLine": false
            },
            "id": "User.Copy",
            "name": "User | Edit: Copy"
        },
        {
            "command": "paste",
            "id": "User.Paste",
            "name": "User | Edit: Paste"
        },
        {
            "command": "find",
            "id": "User.Find",
            "name": "User | Edit: Search"
        },
        {
            "command":
            {
                "action": "splitPane",
                "split": "auto",
                "splitMode": "duplicate"
            },
            "id": "User.SplitPaneAuto",
            "name": "User | Pane: Split automatically"
        },
        {
            "command":
            {
                "action": "splitPane",
                "split": "vertical",
                "splitMode": "duplicate"
            },
            "id": "User.SplitPaneRight",
            "name": "User | Pane: Split right"
        },
        {
            "command":
            {
                "action": "splitPane",
                "split": "horizontal",
                "splitMode": "duplicate"
            },
            "id": "User.SplitPaneDown",
            "name": "User | Pane: Split down"
        },
        {
            "command": "closePane",
            "id": "User.ClosePane",
            "name": "User | Pane: Close"
        },
        {
            "command": "togglePaneZoom",
            "id": "User.TogglePaneZoom",
            "name": "User | Pane: Toggle zoom"
        },
        {
            "command": "commandPalette",
            "id": "User.CommandPalette",
            "name": "User | Window: Command palette"
        },
        {
            "command":
            {
                "action": "newTab",
                "commandline": "pwsh.exe -NoLogo -NoProfile -File \"%USERPROFILE%\\.config\\powershell\\Select-WslDistribution.ps1\"",
                "tabTitle": "WSL"
            },
            "id": "User.WslLauncher",
            "name": "User | WSL: Select distribution"
        },
        {
            "command": "newTab",
            "id": "User.NewTab",
            "name": "User | Tab: New tab"
        },
        {
            "command": "newWindow",
            "id": "User.NewWindow",
            "name": "User | Window: New window"
        },
        {
            "command":
            {
                "action": "moveFocus",
                "direction": "left"
            },
            "id": "User.FocusLeft",
            "name": "User | Pane: Focus left"
        },
        {
            "command":
            {
                "action": "resizePane",
                "direction": "left"
            },
            "id": "User.ResizeLeft",
            "name": "User | Pane: Resize left"
        },
        {
            "command":
            {
                "action": "moveFocus",
                "direction": "down"
            },
            "id": "User.FocusDown",
            "name": "User | Pane: Focus down"
        },
        {
            "command":
            {
                "action": "resizePane",
                "direction": "down"
            },
            "id": "User.ResizeDown",
            "name": "User | Pane: Resize down"
        },
        {
            "command":
            {
                "action": "moveFocus",
                "direction": "up"
            },
            "id": "User.FocusUp",
            "name": "User | Pane: Focus up"
        },
        {
            "command":
            {
                "action": "resizePane",
                "direction": "up"
            },
            "id": "User.ResizeUp",
            "name": "User | Pane: Resize up"
        },
        {
            "command":
            {
                "action": "moveFocus",
                "direction": "right"
            },
            "id": "User.FocusRight",
            "name": "User | Pane: Focus right"
        },
        {
            "command":
            {
                "action": "resizePane",
                "direction": "right"
            },
            "id": "User.ResizeRight",
            "name": "User | Pane: Resize right"
        }
    ],
    "alwaysShowTabs": true,
    "centerOnLaunch": true,
    "copyFormatting": "none",
    "copyOnSelect": true,
    "experimental.rightClickContextMenu": true,
    "defaultProfile": "{574e775e-4f2a-5b96-ac1e-a2962a402336}",
    "disabledProfileSources":
    [
        "Windows.Terminal.Azure",
        "Windows.Terminal.Wsl",
        "Microsoft.WSL"
    ],
    "initialCols": 128,
    "initialRows": 32,
    "keybindings":
    [
        {
            "id": "User.SplitPaneRight",
            "keys": "ctrl+shift+\\"
        },
        {
            "id": null,
            "keys": "ctrl+space"
        },
        {
            "id": null,
            "keys": "alt+shift+d"
        },
        {
            "id": null,
            "keys": "ctrl+c"
        },
        {
            "id": "User.TogglePaneZoom",
            "keys": "ctrl+shift+z"
        },
        {
            "id": "User.Find",
            "keys": "ctrl+shift+f"
        },
        {
            "id": null,
            "keys": "ctrl+v"
        },
        {
            "id": null,
            "keys": "enter"
        },
        {
            "id": "User.Copy",
            "keys": "ctrl+shift+c"
        },
        {
            "id": "User.SplitPaneDown",
            "keys": "ctrl+shift+/"
        },
        {
            "id": "User.ClosePane",
            "keys": "ctrl+shift+w"
        },
        {
            "id": "User.ResizeLeft",
            "keys": "alt+shift+h"
        },
        {
            "id": "User.Paste",
            "keys": "ctrl+shift+v"
        },
        {
            "id": "User.WslLauncher",
            "keys": "ctrl+shift+o"
        },
        {
            "id": "User.FocusLeft",
            "keys": "ctrl+shift+left"
        },
        {
            "id": "User.FocusDown",
            "keys": "ctrl+shift+down"
        },
        {
            "id": "User.ResizeDown",
            "keys": "alt+shift+j"
        },
        {
            "id": "User.FocusUp",
            "keys": "ctrl+shift+up"
        },
        {
            "id": "User.ResizeUp",
            "keys": "alt+shift+k"
        },
        {
            "id": "User.FocusRight",
            "keys": "ctrl+shift+right"
        },
        {
            "id": "User.ResizeRight",
            "keys": "alt+shift+l"
        },
        {
            "id": "User.FocusLeft",
            "keys": "ctrl+shift+h"
        },
        {
            "id": "User.FocusDown",
            "keys": "ctrl+shift+j"
        },
        {
            "id": "User.FocusUp",
            "keys": "ctrl+shift+k"
        },
        {
            "id": "User.FocusRight",
            "keys": "ctrl+shift+l"
        },
        {
            "id": "Terminal.DuplicateTab",
            "keys": "ctrl+shift+t"
        },
        {
            "id": "User.NewWindow",
            "keys": "ctrl+shift+n"
        },
        {
            "id": "User.CommandPalette",
            "keys": "ctrl+shift+p"
        }
    ],
    "language": "en-US",
    "launchMode": "default",
    "newTabMenu":
    [
        {
            "type": "remainingProfiles"
        }
    ],
    "profiles":
    {
        "defaults":
        {
            "bellStyle": "taskbar",
            "colorScheme": "Duskfox",
            "cursorShape": "filledBox",
            "font":
            {
                "face": "FiraCode Nerd Font",
                "features":
