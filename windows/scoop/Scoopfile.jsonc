{
  "config": {
    "update_nightly": true
  },
  "buckets": [
    {
      "Name": "main",
      "Source": "https://github.com/ScoopInstaller/Main"
    },
    {
      "Name": "extras",
      "Source": "https://github.com/ScoopInstaller/Extras"
    },
    {
      "Name": "versions",
      "Source": "https://github.com/ScoopInstaller/Versions"
    },
    {
      "Name": "nerd-fonts",
      "Source": "https://github.com/matthewjberger/scoop-nerd-fonts"
    }
  ],
  "apps": [
    { "Name": "neovim-nightly", "Source": "versions", "Info": "" },

    // VCS
    // Git also supplies sh.exe for Starship's Windows Git modules.
    { "Name": "git", "Source": "main", "Info": "" },
    { "Name": "git-lfs", "Source": "main", "Info": "" },
    { "Name": "delta", "Source": "main", "Info": "" },
    { "Name": "dotter", "Source": "main", "Info": "" },
    { "Name": "lazygit", "Source": "extras", "Info": "" },

    // Shell
    { "Name": "pwsh", "Source": "main", "Info": "" },
    { "Name": "psfzf", "Source": "extras", "Info": "" },
    { "Name": "nu", "Source": "main", "Info": "" },
    { "Name": "shellcheck", "Source": "main", "Info": "" },
    { "Name": "shfmt", "Source": "main", "Info": "" },

    // Must-have tools
    { "Name": "atuin", "Source": "main", "Info": "" },
    { "Name": "bat", "Source": "main", "Info": "" },
    { "Name": "broot", "Source": "main", "Info": "" },
    { "Name": "chafa", "Source": "main", "Info": "" },
    { "Name": "direnv", "Source": "main", "Info": "" },
    { "Name": "dprint", "Source": "main", "Info": "" },
    { "Name": "eza", "Source": "main", "Info": "" },
    { "Name": "fd", "Source": "main", "Info": "" },
    { "Name": "fzf", "Source": "main", "Info": "" },
    { "Name": "ripgrep", "Source": "main", "Info": "" },
    { "Name": "sd", "Source": "main", "Info": "" },
    { "Name": "starship", "Source": "main", "Info": "" },
    { "Name": "yazi", "Source": "main", "Info": "" },
    { "Name": "zoxide", "Source": "main", "Info": "" },

    // Terminal mux
    { "Name": "zellij", "Source": "main", "Info": "" },

    // C/C++ tools
    { "Name": "ccache", "Source": "main", "Info": "" },
    { "Name": "clangd", "Source": "main", "Info": "" },
    { "Name": "cmake", "Source": "main", "Info": "" },
    { "Name": "gersemi", "Source": "extras", "Info": "" },
    { "Name": "llvm", "Source": "main", "Info": "" },
    { "Name": "mold", "Source": "main", "Info": "" },
    { "Name": "ninja", "Source": "main", "Info": "" },

    // Python
    { "Name": "python", "Source": "main", "Info": "" },
    { "Name": "uv", "Source": "main", "Info": "" },

    // AI
    { "Name": "codex", "Source": "main", "Info": "" },

    // Utils
    { "Name": "ast-grep", "Source": "main", "Info": "" },
    { "Name": "btop", "Source": "main", "Info": "" },
    { "Name": "curl", "Source": "main", "Info": "" },
    { "Name": "wget", "Source": "main", "Info": "" },
    { "Name": "tree-sitter", "Source": "main", "Info": "" },

    // Windows utilities
    { "Name": "7zip", "Source": "main", "Info": "" },
    { "Name": "nssm", "Source": "main", "Info": "" },
    { "Name": "bulk-crap-uninstaller", "Source": "extras", "Info": "" },
    { "Name": "crystaldiskinfo", "Source": "extras", "Info": "" },
    { "Name": "crystaldiskmark", "Source": "extras", "Info": "" },
    { "Name": "ddu", "Source": "extras", "Info": "" },
    { "Name": "fancontrol", "Source": "extras", "Info": "" },
    { "Name": "hwinfo", "Source": "extras", "Info": "" },
    { "Name": "nilesoft-shell", "Source": "extras", "Info": "" },
    { "Name": "powertoys", "Source": "extras", "Info": "" },
    { "Name": "simplewall", "Source": "extras", "Info": "" },
    { "Name": "soundswitch", "Source": "extras", "Info": "" },
    { "Name": "sysinternals", "Source": "extras", "Info": "" },
    { "Name": "winscp", "Source": "extras", "Info": "" },

    // Desktop apps
    { "Name": "windows-terminal", "Source": "extras", "Info": "" },
    { "Name": "windows-terminal-preview", "Source": "versions", "Info": "" },
    { "Name": "karing", "Source": "extras", "Info": "" },
    { "Name": "wezterm-nightly", "Source": "versions", "Info": "" },

    // Fonts
    { "Name": "FiraCode", "Source": "nerd-fonts", "Info": "" },
    { "Name": "FiraCode-NF", "Source": "nerd-fonts", "Info": "" }
  ]
}
