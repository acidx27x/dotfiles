--height=~60%
--layout=reverse
--scroll-off=5
--popup=center,90%,60%
--border
--info=inline
--highlight-line
--color=hl:#2dd4bf
--prompt='∼ '
--pointer='▶'
--marker='✓'
--preview-window=up,50%,border-bottom
--bind=alt-w:toggle-preview-wrap
--bind=alt-l:toggle-wrap
--bind=alt-p:toggle-preview
--bind='alt-o:change-preview-window(right,60%,border-left|up,50%,border-bottom)'
--bind=ctrl-b:preview-page-up
--bind=ctrl-f:preview-page-down
--bind=ctrl-u:half-page-up
--bind=ctrl-d:half-page-down
--walker=file,dir,hidden
--walker-skip=.git,node_modules
