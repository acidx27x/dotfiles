# Commit history
set main-view-date = relative-compact
set main-view-id = yes
set main-view-author-display = abbreviated
set commit-order = default

# Search
set ignore-case = smart-case

# Diffs
set diff-context = 5

# Blame: detect moved lines (-M) and copied lines (-C).
set blame-options = -M -C

# Appearance
set line-graphics = auto
set vertical-split = auto
set wrap-lines = yes
set mouse = yes

# Refresh when changes are detected in another view.
set refresh-mode = auto

# Kanagawa: 256-color approximations of the lazygit/tuicr palette.
# Inherit the terminal background; keep Git's colors from overriding this theme.
set git-colors = no

color default color187 default
color cursor color187 color60 bold
color cursor-blur color187 color236
color title-focus color107 color236 bold
color title-blur color243 color236
color status color180 default
color search-result color235 color180
color delimiter color242 default
color line-number color242 default
color header color180 default bold
