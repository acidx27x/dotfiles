# Iceberg Dark colors matching starship/.config/starship.toml.
skin: {
    default: "#c6c8d1 none"
    tree: "#6b7089 none"
    parent: "#828597 none"
    file: "#c6c8d1 none"
    directory: "#84a0c6 none bold"
    exe: "#b4be82 none"
    link: "#89b8c2 none"
    pruning: "#6b7089 none italic"
    selected_line: "none #3d425b"
    char_match: "#e2a478 none bold"
    file_error: "#e27878 none"
    flag_label: "#adb1c4 none"
    flag_value: "#84a0c6 none bold"
    input: "#c6c8d1 none"
    status_error: "#161821 #e27878"
    status_job: "#e2a478 #36384a"
    status_normal: "#c6c8d1 #36384a"
    status_italic: "#89b8c2 #36384a"
    status_bold: "#84a0c6 #36384a bold"
    status_code: "#b4be82 #36384a"
    status_ellipsis: "#828597 #36384a"
    preview: "#c6c8d1 none"
    preview_title: "#84a0c6 none bold"
    preview_separator: "#6b7089 none"
    preview_line_number: "#828597 none"
    preview_match: "none #444b71"
    help_paragraph: "#c6c8d1 none"
    help_bold: "#84a0c6 none bold"
    help_code: "#b4be82 #36384a"
    help_headers: "#84a0c6 none bold"
    git_insertions: "#b4be82 none"
    git_deletions: "#e27878 none"
    git_status_modified: "#e2a478 none"
    git_status_staged: "#b4be82 none"
    git_status_new: "#89b8c2 none"
    git_status_conflicted: "#e27878 none"
}
