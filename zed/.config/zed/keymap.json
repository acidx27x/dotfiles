// INFO: secondary-k for workspace, secondary-l for editor (Cmd on macOS, Ctrl elsewhere)
// TODO toggle inline diagnostics
[
  {
    "use_key_equivalents": true,
    "unbind": {
      "secondary-alt-,": "zed::OpenSettingsFile",
      "alt-cmd-,": "zed::OpenSettingsFile",
      "tab": "menu::SelectNext",
      "shift-tab": "menu::SelectPrevious"
    }
  },
  {
    "context": "Welcome",
    "unbind": {
      "secondary-n": "workspace::NewFile"
    }
  },
  {
    // secondary-l is the editor prefix
    "context": "Editor",
    "unbind": {
      "secondary-l": "editor::SelectLine"
    }
  },
  // {
  //   "context": "Editor && VimControl && !VimWaiting && !menu",
  //   "bindings": {
  //     "ctrl-w z": "workspace::ToggleZoom",
  //     // "shift-k": "editor::Hover",
  //     // "space l a": "editor::ToggleCodeActions",
  //     // "space l r": "editor::Rename",
  //     "space f": "file_finder::Toggle",
  //     "space o": "tab_switcher::Toggle",
  //     "space p": "outline::Toggle",
  //   }
  // },
  {
    // better complition behavior begin
    "context": "Editor",
    "bindings": {
      "alt-e": "editor::Cancel",
      "tab": "editor::NextSnippetTabstop",
      "shift-tab": "editor::PreviousSnippetTabstop"
    }
  },
  {
    "context": "Editor && showing_completions",
    "bindings": {
      "alt-e": "editor::Cancel",
      "tab": "editor::ConfirmCompletion",
      "enter": "editor::Newline"
    }
  }, // better complition behavior end
  {
    // remap unused/uncomfy mapping begin
    "context": "Workspace",
    "use_key_equivalents": true,
    "unbind": {
      "secondary-k secondary-s": "zed::OpenKeymap",
      "secondary-k secondary-shift-s": "workspace::SaveWithoutFormat",
      "cmd-k s": "workspace::SaveWithoutFormat",
      "secondary-k secondary-t": "theme_selector::Toggle",
      "secondary-n": "workspace::NewFile"
    },
    "bindings": {
      "secondary-k secondary-k": "zed::OpenKeymap"
    }
  },
  {
    "context": "!SettingsWindow",
    "use_key_equivalents": true,
    "unbind": {
      "secondary-,": "zed::OpenSettings",
      "cmd-,": "zed::OpenSettings"
    },
    "bindings": {
      "secondary-k secondary-s": "zed::OpenSettings"
    }
  },
  {
    "context": "VimControl && !menu",
    "unbind": {
      "shift-tab": "vim::Tab"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "shift-tab": "editor::Backtab"
    }
  }, // remap unused/uncomfy mapping end
  {
    // toggle dock begin
    "context": "AgentPanel",
    "unbind": {
      "secondary-shift-e": "project_panel::ToggleFocus"
    }
  },
  {
    "unbind": {
      "alt-shift-l": "lsp_tool::ToggleMenu"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "secondary-k secondary-d": [
        "editor::SelectNext",
        {
          "replace_newest": true
        }
      ],
      "secondary-k secondary-l": "editor::ToggleFold",
      "secondary-k secondary-c": [
        "editor::ToggleComments",
        {
          "advance_downwards": false
        }
      ],
      "secondary-k secondary-h": "call_hierarchy::ShowIncomingCalls"
    }
  },
  {
    "context": "!Terminal",
    "unbind": {
      "secondary-shift-c": "collab_panel::ToggleFocus"
    }
  },
  {
    "context": "Workspace",
    "use_key_equivalents": true,
    "unbind": {
      "secondary-shift-`": "workspace::NewTerminal",
      "ctrl-~": "workspace::NewTerminal",
      "ctrl-`": "terminal_panel::Toggle",
      "secondary-alt-j": "multi_workspace::ToggleWorkspaceSidebar",
      "secondary-shift-/": "agent::ToggleFocus",
      "secondary-?": "agent::ToggleFocus",
      "secondary-shift-e": "project_panel::ToggleFocus",
      "secondary-shift-m": "diagnostics::Deploy",
      "secondary-shift-d": "debug_panel::ToggleFocus",
      "secondary-shift-b": "outline_panel::ToggleFocus",
      "ctrl-shift-g": "git_panel::ToggleFocus",
      "secondary-k m": "language_selector::Toggle",
      "secondary-j": "workspace::ToggleBottomDock",
      "secondary-b": "workspace::ToggleLeftDock",
      "secondary-alt-b": "workspace::ToggleRightDock",
      "secondary-k secondary-shift-t": "theme::ToggleMode"
    },
    "bindings": {
      "secondary-k secondary-t": "terminal_panel::Toggle",
      "secondary-k secondary-h": "multi_workspace::ToggleWorkspaceSidebar",
      "secondary-k secondary-a": "agent::Toggle",
      "secondary-k secondary-n": "project_panel::Toggle",
      "secondary-k secondary-i": "diagnostics::Deploy",
      "secondary-k secondary-d": "debug_panel::Toggle",
      "secondary-k secondary-u": "outline_panel::Toggle",
      "secondary-k secondary-g": "git_panel::Toggle",
      "secondary-k secondary-l": "language_selector::Toggle",
      "secondary-k secondary--": "workspace::ToggleBottomDock",
      "secondary-k secondary-,": "workspace::ToggleLeftDock",
      "secondary-k secondary-.": "workspace::ToggleRightDock",
      "secondary-k secondary-e": "editor::ToggleFocus",
      "secondary-k secondary-shift-t": "workspace::OpenInTerminal",
      "secondary-k secondary-c": "collab_panel::Toggle"
    }
  }, //  toggle dock end
  {
    // editor begin
    "context": "Editor",
    "unbind": {
      // use same bindings for Format and FormatSelection
      // can`t place in one object due to json error begin
      "alt-shift-f": "editor::Format",
      "secondary-k secondary-f": "editor::FormatSelections"
    },
    "bindings": {
      "secondary-l secondary-f": "editor::Format"
    }
  },
  {
    "context": "Editor && selection",
    "bindings": {
      "secondary-l secondary-f": "editor::FormatSelections"
    }
  },
  {
    "context": "Editor && vim_mode == visual",
    "bindings": {
      "secondary-l secondary-f": "editor::FormatSelections"
    }
  },
  {
    "context": "!AcpThread > Editor && mode == full",
    "unbind": {
      "secondary-shift-e": "pane::RevealInProjectPanel"
    },
    "bindings": {
      "secondary-l secondary-n": "pane::RevealInProjectPanel"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "secondary-k p": "workspace::CopyPath",
      "secondary-k r": "editor::RevealInFileManager",
      "secondary-k secondary-b": "editor::BlameHover"
    },
    "bindings": {
      "secondary-l secondary-r": "editor::RevealInFileManager",
      "secondary-l secondary-b": "editor::BlameHover"
    }
  }, // editor end
  {
    "context": "Editor",
    "unbind": {
      "secondary-k p": "editor::CopyPath"
    }
  },
  {
    // remap/unmap unused toggle comments begin
    "context": "Editor",
    "use_key_equivalents": true,
    "unbind": {
      "secondary-/": [
        "editor::ToggleComments",
        {
          "advance_downwards": false
        }
      ],
      "secondary-k secondary-c": [
        "editor::ToggleComments",
        {
          "advance_downwards": false
        }
      ],
      "alt-shift-a": "editor::ToggleBlockComments",
      "secondary-k secondary-/": "editor::ToggleBlockComments"
    },
    "bindings": {
      "secondary-l secondary-c": [
        "editor::ToggleComments",
        {
          "advance_downwards": false
        }
      ],
      "secondary-l secondary-shift-c": "editor::ToggleBlockComments"
    }
  }, // remap/unmap unused toggle comments end
  {
    // better cursor placement begin
    "context": "VimControl && !menu",
    "bindings": {
      "ctrl-d": ["workspace::SendKeystrokes", "ctrl-d z z"],
      "ctrl-u": ["workspace::SendKeystrokes", "ctrl-u z z"],
      "shift-g": ["workspace::SendKeystrokes", "shift-g z z"]
    }
  }, // better cursor placement end
  {
    // subword motion to support snake_case, camelCase, etc
    "context": "VimControl && !menu && vim_mode != operator",
    "bindings": {
      "w": "vim::NextSubwordStart",
      "b": "vim::PreviousSubwordStart",
      "e": "vim::NextSubwordEnd",
      "g e": "vim::PreviousSubwordEnd"
    }
  },
  {
    // vim surround
    "context": "vim_mode == visual",
    "bindings": {
      "shift-s a": "vim::PushAddSurrounds",
      "shift-s d": "vim::PushDeleteSurrounds",
      "shift-s c": "vim::PushChangeSurrounds"
    }
  },
  {
    // vim exchange
    "context": "vim_mode == visual",
    "bindings": {
      "shift-x": "vim::Exchange"
    }
  },
  {
    // vim sneak
    "context": "vim_mode == normal || vim_mode == visual",
    "bindings": {
      "shift-z f": "vim::PushSneak",
      "shift-z b": "vim::PushSneakBackward"
    }
  },
  {
    // Use neovim's yank behavior: yank to end of line.
    "context": "vim_mode == normal && !menu",
    "bindings": {
      "shift-y": ["workspace::SendKeystrokes", "y $"]
    }
  },
  {
    // move lines with secondary + alt + hjkl begin
    "context": "Editor",
    "use_key_equivalents": true,
    "unbind": {
      "alt-up": "editor::MoveLineUp",
      "alt-down": "editor::MoveLineDown"
    },
    "bindings": {
      "secondary-alt-j": "editor::MoveLineDown",
      "secondary-alt-k": "editor::MoveLineUp",
      "secondary-alt-h": "vim::Outdent",
      "secondary-alt-l": "vim::Indent"
    }
  },
  {
    "context": "vim_mode == visual",
    "use_key_equivalents": true,
    "bindings": {
      "secondary-alt-h": ["workspace::SendKeystrokes", "< g v"],
      "secondary-alt-l": ["workspace::SendKeystrokes", "> g v"]
    }
  },
  {
    "context": "vim_mode == normal || vim_mode == visual || vim_mode == operator",
    "unbind": {
      "[ e": "editor::MoveLineUp",
      "] e": "editor::MoveLineDown"
    }
  },
  {
    "context": "VimControl && !menu",
    "unbind": {
      "ctrl-j": "vim::Down"
    }
  }, // move lines with secondary + alt + hjkl end
  {
    // resize panes with alt + arrows begin
    "context": "Pane || Dock",
    "bindings": {
      "alt-up": "vim::ResizePaneUp",
      "alt-down": "vim::ResizePaneDown",
      "alt-left": "vim::ResizePaneLeft",
      "alt-right": "vim::ResizePaneRight"
    }
  },
  {
    "context": "(VimControl && !menu) || (!Editor && !Terminal)",
    "unbind": {
      "ctrl-w shift-=": "vim::ResizePaneUp",
      "ctrl-w -": "vim::ResizePaneDown",
      "ctrl-w shift-,": "vim::ResizePaneLeft",
      "ctrl-w shift-.": "vim::ResizePaneRight"
    }
  }, // resize panes with alt + arrows end
  {
    // use alt + hjkl to focus in all the editor docks
    // (the terminal, project panel, assistant panel, ...) begin
    "context": "Workspace",
    "use_key_equivalents": true,
    "unbind": {
      "secondary-k secondary-up": "workspace::ActivatePaneUp",
      "secondary-k secondary-down": "workspace::ActivatePaneDown",
      "secondary-k secondary-left": "workspace::ActivatePaneLeft",
      "secondary-k secondary-right": "workspace::ActivatePaneRight"
    },
    "bindings": {
      "alt-k": "workspace::ActivatePaneUp",
      "alt-j": "workspace::ActivatePaneDown",
      "alt-h": "workspace::ActivatePaneLeft",
      "alt-l": "workspace::ActivatePaneRight"
    }
  },
  {
    "context": "!Editor && !Terminal",
    "unbind": {
      "space w k": "workspace::ActivatePaneUp",
      "space w j": "workspace::ActivatePaneDown",
      "space w h": "workspace::ActivatePaneLeft",
      "space w l": "workspace::ActivatePaneRight"
    }
  },
  {
    "context": "(VimControl && !menu) || (!Editor && !Terminal)",
    "unbind": {
      "ctrl-w k": "workspace::ActivatePaneUp",
      "ctrl-w up": "workspace::ActivatePaneUp",
      "ctrl-w ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-w j": "workspace::ActivatePaneDown",
      "ctrl-w down": "workspace::ActivatePaneDown",
      "ctrl-w ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-w h": "workspace::ActivatePaneLeft",
      "ctrl-w left": "workspace::ActivatePaneLeft",
      "ctrl-w ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-w l": "workspace::ActivatePaneRight",
      "ctrl-w right": "workspace::ActivatePaneRight",
      "ctrl-w ctrl-l": "workspace::ActivatePaneRight"
    }
    // use alt + hjkl to focus in all the editor docks
    // the terminal, project panel, assistant panel, ...) end
  },
  {
    // terminal begin
    "context": "Terminal",
    "use_key_equivalents": true,
    "unbind": {
      "ctrl-shift-space": "terminal::ToggleViMode",
      "secondary-n": "workspace::NewTerminal",
      "cmd-k": "terminal::Clear"
    },
    "bindings": {
      "secondary-k secondary-n": "workspace::NewTerminal"
    }
  }, // terminal end
  {
    "context": "os == macos > Terminal",
    "use_key_equivalents": true,
    "bindings": {
      "ctrl-t ctrl-m": "terminal::ToggleViMode",
      "cmd-shift-k": "terminal::Clear"
    }
  },
  {
    "context": "(os == linux || os == windows) > Terminal",
    "use_key_equivalents": true,
    "bindings": {
      "ctrl-a": ["terminal::SendKeystroke", "ctrl-a"],
      "ctrl-b": ["terminal::SendKeystroke", "ctrl-b"],
      "ctrl-c": ["terminal::SendKeystroke", "ctrl-c"],
      "ctrl-d": ["terminal::SendKeystroke", "ctrl-d"],
      "ctrl-e": ["terminal::SendKeystroke", "ctrl-e"],
      "ctrl-f": ["terminal::SendKeystroke", "ctrl-f"],
      "ctrl-g": ["terminal::SendKeystroke", "ctrl-g"],
      "ctrl-h": ["terminal::SendKeystroke", "ctrl-h"],
      "ctrl-i": ["terminal::SendKeystroke", "ctrl-i"],
      "ctrl-j": ["terminal::SendKeystroke", "ctrl-j"],
      "ctrl-k": ["terminal::SendKeystroke", "ctrl-k"],
      "ctrl-l": ["terminal::SendKeystroke", "ctrl-l"],
      "ctrl-m": ["terminal::SendKeystroke", "ctrl-m"],
      "ctrl-n": ["terminal::SendKeystroke", "ctrl-n"],
      "ctrl-o": ["terminal::SendKeystroke", "ctrl-o"],
      "ctrl-p": ["terminal::SendKeystroke", "ctrl-p"],
      "ctrl-q": ["terminal::SendKeystroke", "ctrl-q"],
      "ctrl-r": ["terminal::SendKeystroke", "ctrl-r"],
      "ctrl-s": ["terminal::SendKeystroke", "ctrl-s"],
      "ctrl-t": ["terminal::SendKeystroke", "ctrl-t"],
      "ctrl-u": ["terminal::SendKeystroke", "ctrl-u"],
      "ctrl-v": ["terminal::SendKeystroke", "ctrl-v"],
      "ctrl-w": ["terminal::SendKeystroke", "ctrl-w"],
      "ctrl-x": ["terminal::SendKeystroke", "ctrl-x"],
      "ctrl-y": ["terminal::SendKeystroke", "ctrl-y"],
      "ctrl-z": ["terminal::SendKeystroke", "ctrl-z"],
      "secondary-k secondary-m": "terminal::ToggleViMode"
    }
  },
  {
    // project panel begin
    "context": "ProjectPanel",
    "unbind": {
      "alt-shift-c": "workspace::CopyPath",
      "secondary-k secondary-shift-c": "workspace::CopyRelativePath",
      "ctrl-alt-c": "project_panel::CopyPath",
      "cmd-alt-c": "workspace::CopyPath",
      "secondary-alt-shift-c": "workspace::CopyRelativePath"
    }
  },
  {
    "context": "ProjectPanel && not_editing",
    "use_key_equivalents": true,
    "unbind": {
      "shift-5": "project_panel::NewFile",
      "d": "project_panel::NewDirectory",
      "x": "project_panel::RevealInFileManager",
      "s": "workspace::OpenWithSystem",
      "secondary-x": "project_panel::Cut",
      "space": "project_panel::Open",
      "p": "project_panel::Open",
      "t": "project_panel::OpenPermanent",
      "o": "project_panel::OpenSplitHorizontal",
      "h": "project_panel::CollapseSelectedEntry"
    },
    "bindings": {
      "a": "project_panel::NewFile",
      "shift-a": "project_panel::NewDirectory",
      "x": "project_panel::Cut",
      "y": "project_panel::Copy",
      "p": "project_panel::Paste",
      "secondary-r": "project_panel::RevealInFileManager",
      "secondary-s": "workspace::OpenWithSystem",
      "secondary-o": "project_panel::Open",
      "secondary-shift-o": "project_panel::OpenPermanent",
      "h": "project_panel::OpenSplitHorizontal",
      "v": "project_panel::OpenSplitVertical"
    }
  }, // project panel end
  {
    // outline panel begin
    "context": "OutlinePanel && not_editing",
    "unbind": {
      "alt-shift-c": "workspace::CopyPath",
      "secondary-alt-shift-c": "workspace::CopyRelativePath",
      "ctrl-alt-c": "outline_panel::CopyPath",
      "cmd-alt-c": "workspace::CopyPath"
    }
  }, // outline panel end
  {
    // pane begin
    "context": "Pane",
    "unbind": {
      "secondary-k shift-enter": "pane::TogglePinTab",
      "alt-l": "search::ToggleSelection"
    }
  },
  {
    "context": "Pane && !Terminal",
    "use_key_equivalents": true,
    "bindings": {
      "secondary-l secondary-p": "pane::TogglePinTab"
    }
  }, // pane end
  {
    // debugger begin
    "context": "Editor",
    "bindings": {
      "alt-d e": "editor::EnableBreakpoint",
      "alt-d d": "editor::DisableBreakpoint",
      "alt-d t": "editor::ToggleBreakpoint"
    }
  },
  {
    "context": "Workspace && !Terminal && !ProjectPanel",
    "bindings": {
      "alt-d r": "debugger::Start",
      "alt-d shift-r": "debugger::RerunSession",
      "alt-d p": "debugger::Pause",
      "alt-d shift-p": "debugger::Stop",
      "alt-d .": "debugger::RunToCursor",
      "alt-d s": "debugger::StepInto",
      "alt-d b": "debugger::StepBack",
      "alt-d n": "debugger::StepOver",
      "alt-d o": "debugger::StepOut",
      "alt-d v": "debugger::EvaluateSelectedText"
    }
  },
  {
    "context": "Workspace && debugger_stopped && !Terminal && !ProjectPanel",
    "bindings": {
      "alt-d c": "debugger::Continue"
    }
  }, // debugger end
  {
    // task begin
    "context": "Workspace",
    "unbind": {
      "alt-shift-t": "task::Spawn",
      "alt-t": "task::Rerun",
      "alt-shift-r": [
        "task::Spawn",
        {
          "reveal_target": "center"
        }
      ],
      "secondary-shift-r": [
        "task::Rerun",
        {
          "reevaluate_context": false
        }
      ],
      "cmd-shift-r": "task::Spawn"
    }
  },
  {
    "context": "Workspace && !Terminal",
    "bindings": {
      "alt-t n": "task::Spawn",
      "alt-t r": "task::Rerun",
      "alt-t shift-n": [
        "task::Spawn",
        {
          "reveal_target": "center"
        }
      ],
      "alt-t shift-r": [
        "task::Rerun",
        {
          "reevaluate_context": false
        }
      ]
    }
  }, // task end
  {
    // remap spoiled copy/paste keymaps begin
    "context": "Editor",
    "unbind": {
      "ctrl-insert": "editor::Copy",
      "shift-insert": "editor::Paste"
    }
  }, // remap spoiled copy/paste keymaps end
  {
    // TODO
    "context": "Editor",
    "unbind": {
      "secondary-k secondary-i": "editor::Hover"
    },
    "bindings": {
      "secondary-l secondary-k": "editor::Hover"
    }
  },
  {
    // bookmarks
    "context": "Editor",
    "use_key_equivalents": true,
    "bindings": {
      "secondary-l secondary-m": "editor::ToggleBookmark",
      "secondary-l secondary-shift-m": "editor::ViewBookmarks",
      "secondary-.": "editor::GoToNextBookmark",
      "secondary-,": "editor::GoToPreviousBookmark"
    }
  }
]
