// INFO: secondary-k for workspace, secondary-l for editor (Cmd on macOS, Ctrl elsewhere).
[
  {
    // Remove global shortcuts that conflict with the custom key layout.
    "use_key_equivalents": true,
    "unbind": {
      "secondary-alt-,": "zed::OpenSettingsFile",
      "alt-cmd-,": "zed::OpenSettingsFile",
      "tab": "menu::SelectNext",
      "shift-tab": "menu::SelectPrevious"
    }
  },
  {
    // Disable New File on the welcome screen.
    "context": "Welcome",
    "unbind": {
      "secondary-n": "workspace::NewFile"
    }
  },
  {
    // secondary-l is the editor prefix.
    "context": "Editor",
    "unbind": {
      "secondary-l": "editor::SelectLine"
    },
    "bindings": {
      "secondary-l secondary-i": "editor::ConvertIndentationToSpaces",
      "secondary-l secondary-shift-i": "editor::ConvertIndentationToTabs",
      "secondary-l secondary-s": "editor::SortLinesCaseInsensitive",
      "secondary-l secondary-=": "workspace::ToggleCenteredLayout",
      "secondary-l secondary-w": "workspace::SaveWithoutFormat"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "alt-e": "editor::Cancel",
      "tab": "editor::NextSnippetTabstop",
      "shift-tab": "editor::PreviousSnippetTabstop"
    }
  },
  {
    // Preserve completion popup controls and Enter behavior.
    "context": "Editor && showing_completions",
    "bindings": {
      "alt-e": "editor::Cancel",
      "tab": "editor::ConfirmCompletion",
      "enter": "editor::Newline"
    }
  },
  {
    "context": "Workspace",
    "use_key_equivalents": true,
    "unbind": {
      "secondary-k secondary-s": "zed::OpenKeymap",
      "secondary-k secondary-shift-s": "workspace::SaveWithoutFormat",
      "cmd-k s": "workspace::SaveWithoutFormat",
      "secondary-k secondary-t": "theme_selector::Toggle",
      "secondary-k secondary-p": "workspace::ReopenLastPicker",
      "secondary-p": "file_finder::Toggle",
      "secondary-n": "workspace::NewFile"
    }
  },
  {
    "context": "FileFinder || (FileFinder > Picker > Editor)",
    "unbind": {
      "secondary-p": "file_finder::Toggle"
    }
  },
  {
    "context": "Workspace && !Terminal",
    "bindings": {
      "secondary-k secondary-b": "tab_switcher::OpenInActivePane",
      "secondary-k secondary-f": "text_finder::Toggle",
      "secondary-k secondary-p": "file_finder::Toggle"
    }
  },
  {
    // Open settings through the workspace prefix.
    "context": "!SettingsWindow",
    "use_key_equivalents": true,
    "unbind": {
      "secondary-,": "zed::OpenSettings",
      "cmd-,": "zed::OpenSettings"
    }
  },
  {
    "context": "!SettingsWindow && !Terminal",
    "use_key_equivalents": true,
    "bindings": {
      "secondary-k secondary-s": "zed::OpenSettings"
    }
  },
  {
    // Free Shift-Tab from Vim's tab action.
    "context": "VimControl && !menu",
    "unbind": {
      "shift-tab": "vim::Tab"
    }
  },
  {
    // Free Shift-Tab from editor outdent.
    "context": "Editor",
    "unbind": {
      "shift-tab": "editor::Backtab"
    }
  },
  {
    "context": "AgentPanel",
    "unbind": {
      "secondary-shift-e": "project_panel::ToggleFocus"
    }
  },
  {
    // Free Alt-Shift-L from the LSP tool menu.
    "unbind": {
      "alt-shift-l": "lsp_tool::ToggleMenu"
    }
  },
  {
    // Free editor chords for the dock and editor prefixes.
    "context": "Editor",
    "unbind": {
      "secondary-k secondary-d": [
        "editor::SelectNext",
        {
          "replace_newest": true
        }
      ],
      "secondary-k secondary-l": "editor::ToggleFold",
      "secondary-k secondary-c": [
        "editor::ToggleComments",
        {
          "advance_downwards": false
        }
      ],
      "secondary-k secondary-h": "call_hierarchy::ShowIncomingCalls"
    }
  },
  {
    // Free the collaboration panel shortcut outside terminals.
    "context": "!Terminal",
    "unbind": {
      "secondary-shift-c": "collab_panel::ToggleFocus"
    }
  },
  {
    // Toggle docks and panels through the workspace prefix.
    "context": "Workspace",
    "use_key_equivalents": true,
    "unbind": {
      "secondary-shift-`": "workspace::NewTerminal",
      "ctrl-~": "workspace::NewTerminal",
      "ctrl-`": "terminal_panel::Toggle",
      "secondary-alt-j": "multi_workspace::ToggleWorkspaceSidebar",
      "secondary-shift-/": "agent::ToggleFocus",
      "secondary-?": "agent::ToggleFocus",
      "secondary-shift-e": "project_panel::ToggleFocus",
      "secondary-shift-m": "diagnostics::Deploy",
      "secondary-shift-d": "debug_panel::ToggleFocus",
      "secondary-shift-b": "outline_panel::ToggleFocus",
      "ctrl-shift-g": "git_panel::ToggleFocus",
      "secondary-k m": "language_selector::Toggle",
      "secondary-j": "workspace::ToggleBottomDock",
      "secondary-b": "workspace::ToggleLeftDock",
      "secondary-alt-b": "workspace::ToggleRightDock",
      "secondary-k secondary-shift-t": "theme::ToggleMode"
    },
    "bindings": {
      "secondary-k secondary-t": "terminal_panel::Toggle",
      "secondary-k secondary-e": "editor::ToggleFocus"
    }
  },
  {
    "context": "Workspace && !Terminal",
    "use_key_equivalents": true,
    "bindings": {
      "secondary-k secondary-k": "zed::OpenKeymap",
      "secondary-k secondary-h": "multi_workspace::ToggleWorkspaceSidebar",
      "secondary-k secondary-a": "agent::Toggle",
      "secondary-k secondary-n": "project_panel::Toggle",
      "secondary-k secondary-i": "diagnostics::Deploy",
      "secondary-k secondary-d": "debug_panel::Toggle",
      "secondary-k secondary-u": "outline_panel::Toggle",
      "secondary-k secondary-g": "git_panel::Toggle",
      "secondary-k secondary-l": "language_selector::Toggle",
      "secondary-k secondary--": "workspace::ToggleBottomDock",
      "secondary-k secondary-,": "workspace::ToggleLeftDock",
      "secondary-k secondary-.": "workspace::ToggleRightDock",
      "secondary-k secondary-shift-t": "workspace::OpenInTerminal",
      "secondary-k secondary-c": "collab_panel::Toggle"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "alt-shift-f": "editor::Format",
      "secondary-k secondary-f": "editor::FormatSelections"
    },
    "bindings": {
      "secondary-l secondary-f": "editor::Format"
    }
  },
  {
    // Format selected text with the editor prefix.
    "context": "Editor && selection",
    "bindings": {
      "secondary-l secondary-f": "editor::FormatSelections"
    }
  },
  {
    // Format Vim Visual selections with the same prefix.
    "context": "Editor && vim_mode == visual",
    "bindings": {
      "secondary-l secondary-f": "editor::FormatSelections"
    }
  },
  {
    // Reveal the current file from full agent threads.
    "context": "!AcpThread > Editor && mode == full",
    "unbind": {
      "secondary-shift-e": "pane::RevealInProjectPanel"
    },
    "bindings": {
      "secondary-l secondary-n": "pane::RevealInProjectPanel"
    }
  },
  {
    // Move file reveal and blame to the editor prefix.
    "context": "Editor",
    "unbind": {
      "secondary-k p": "workspace::CopyPath",
      "secondary-k r": "editor::RevealInFileManager",
      "secondary-k secondary-b": "editor::BlameHover"
    },
    "bindings": {
      "secondary-l secondary-r": "editor::RevealInFileManager",
      "secondary-l secondary-b": "editor::BlameHover"
    }
  },
  {
    // Free the remaining copy-path chord.
    "context": "Editor",
    "unbind": {
      "secondary-k p": "editor::CopyPath"
    }
  },
  {
    // Remap/unmap unused toggle comments begin
    "context": "Editor",
    "use_key_equivalents": true,
    "unbind": {
      "secondary-/": [
        "editor::ToggleComments",
        {
          "advance_downwards": false
        }
      ],
      "secondary-k secondary-c": [
        "editor::ToggleComments",
        {
          "advance_downwards": false
        }
      ],
      "alt-shift-a": "editor::ToggleBlockComments",
      "secondary-k secondary-/": "editor::ToggleBlockComments"
    },
    "bindings": {
      "secondary-l secondary-c": [
        "editor::ToggleComments",
        {
          "advance_downwards": false
        }
      ],
      "secondary-l secondary-shift-c": "editor::ToggleBlockComments"
    }
  },
  {
    "context": "VimControl && !menu",
    "bindings": {
      "ctrl-d": ["workspace::SendKeystrokes", "ctrl-d z z"],
      "ctrl-u": ["workspace::SendKeystrokes", "ctrl-u z z"],
      "shift-g": ["workspace::SendKeystrokes", "shift-g z z"]
    }
  },
  {
    // Subword motion to support snake_case, camelCase, etc.
    "context": "VimControl && !menu && vim_mode != operator",
    "bindings": {
      "w": "vim::NextSubwordStart",
      "b": "vim::PreviousSubwordStart",
      "e": "vim::NextSubwordEnd",
      "g e": "vim::PreviousSubwordEnd"
    }
  },
  {
    // Vim surround.
    "context": "vim_mode == visual",
    "bindings": {
      "shift-s a": "vim::PushAddSurrounds",
      "shift-s d": "vim::PushDeleteSurrounds",
      "shift-s c": "vim::PushChangeSurrounds"
    }
  },
  {
    // Multiline find/till and Sneak jumps; preserve text-object keys such as af and i<.
    "context": "Editor && !menu && (vim_mode == normal || vim_mode == visual || (vim_mode == operator && vim_operator != a && vim_operator != i))",
    "bindings": {
      "f": ["vim::PushFindForward", { "before": false, "multiline": true }],
      "shift-f": ["vim::PushFindBackward", { "after": false, "multiline": true }],
      "t": ["vim::PushFindForward", { "before": true, "multiline": true }],
      "shift-t": ["vim::PushFindBackward", { "after": true, "multiline": true }],
      ">": "vim::PushSneak",
      "<": "vim::PushSneakBackward"
    }
  },
  {
    // Use neovim's yank behavior: yank to end of line.
    "context": "vim_mode == normal && !menu",
    "bindings": {
      "shift-y": ["workspace::SendKeystrokes", "y $"]
    }
  },
  {
    // Move lines with secondary + alt + hjkl begin.
    "context": "Editor",
    "use_key_equivalents": true,
    "unbind": {
      "alt-up": "editor::MoveLineUp",
      "alt-down": "editor::MoveLineDown"
    },
    "bindings": {
      "secondary-alt-j": "editor::MoveLineDown",
      "secondary-alt-k": "editor::MoveLineUp",
      "secondary-alt-h": "vim::Outdent",
      "secondary-alt-l": "vim::Indent"
    }
  },
  {
    // Indent and outdent Visual selections without losing the selection.
    "context": "vim_mode == visual",
    "use_key_equivalents": true,
    "bindings": {
      "secondary-alt-h": [
        "action::Sequence",
        ["vim::Outdent", ["workspace::SendKeystrokes", "g v"]]
      ],
      "secondary-alt-l": [
        "action::Sequence",
        ["vim::Indent", ["workspace::SendKeystrokes", "g v"]]
      ]
    }
  },
  {
    // Free the [e and ]e line-move keys.
    "context": "vim_mode == normal || vim_mode == visual || vim_mode == operator",
    "unbind": {
      "[ e": "editor::MoveLineUp",
      "] e": "editor::MoveLineDown"
    }
  },
  {
    // Free Ctrl-J from Vim's Down motion.
    "context": "VimControl && !menu",
    "unbind": {
      "ctrl-j": "vim::Down"
    }
  }, // Move lines with secondary + alt + hjkl end.
  {
    // Resize panes five steps per Alt-arrow press begin.
    "context": "Pane || Dock",
    "bindings": {
      "alt-up": [
        "action::Sequence",
        [
          "vim::ResizePaneUp",
          "vim::ResizePaneUp",
          "vim::ResizePaneUp",
          "vim::ResizePaneUp",
          "vim::ResizePaneUp"
        ]
      ],
      "alt-down": [
        "action::Sequence",
        [
          "vim::ResizePaneDown",
          "vim::ResizePaneDown",
          "vim::ResizePaneDown",
          "vim::ResizePaneDown",
          "vim::ResizePaneDown"
        ]
      ],
      "alt-left": [
        "action::Sequence",
        [
          "vim::ResizePaneLeft",
          "vim::ResizePaneLeft",
          "vim::ResizePaneLeft",
          "vim::ResizePaneLeft",
          "vim::ResizePaneLeft"
        ]
      ],
      "alt-right": [
        "action::Sequence",
        [
          "vim::ResizePaneRight",
          "vim::ResizePaneRight",
          "vim::ResizePaneRight",
          "vim::ResizePaneRight",
          "vim::ResizePaneRight"
        ]
      ]
    }
  },
  {
    // Keep Zed's Ctrl-W pane resize chords unbound as before.
    "context": "(VimControl && !menu) || (!Editor && !Terminal)",
    "unbind": {
      "ctrl-w shift-=": "vim::ResizePaneUp",
      "ctrl-w -": "vim::ResizePaneDown",
      "ctrl-w shift-,": "vim::ResizePaneLeft",
      "ctrl-w shift-.": "vim::ResizePaneRight"
    }
  }, // Resize panes five steps per Alt-arrow press end.
  {
    // Use alt + hjkl to focus in all the editor docks
    // (the terminal, project panel, assistant panel, ...) begin.
    "context": "Workspace",
    "use_key_equivalents": true,
    "unbind": {
      "secondary-k secondary-up": "workspace::ActivatePaneUp",
      "secondary-k secondary-down": "workspace::ActivatePaneDown",
      "secondary-k secondary-left": "workspace::ActivatePaneLeft",
      "secondary-k secondary-right": "workspace::ActivatePaneRight"
    },
    "bindings": {
      "alt-k": "workspace::ActivatePaneUp",
      "alt-j": "workspace::ActivatePaneDown",
      "alt-h": "workspace::ActivatePaneLeft",
      "alt-l": "workspace::ActivatePaneRight"
    }
  },
  {
    // Free Zed's Space-W pane-focus chords outside editors.
    "context": "!Editor && !Terminal",
    "unbind": {
      "space w k": "workspace::ActivatePaneUp",
      "space w j": "workspace::ActivatePaneDown",
      "space w h": "workspace::ActivatePaneLeft",
      "space w l": "workspace::ActivatePaneRight"
    }
  },
  {
    // Free Ctrl-W pane-focus chords in Vim and non-editor panes.
    "context": "(VimControl && !menu) || (!Editor && !Terminal)",
    "unbind": {
      "ctrl-w k": "workspace::ActivatePaneUp",
      "ctrl-w up": "workspace::ActivatePaneUp",
      "ctrl-w ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-w j": "workspace::ActivatePaneDown",
      "ctrl-w down": "workspace::ActivatePaneDown",
      "ctrl-w ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-w h": "workspace::ActivatePaneLeft",
      "ctrl-w left": "workspace::ActivatePaneLeft",
      "ctrl-w ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-w l": "workspace::ActivatePaneRight",
      "ctrl-w right": "workspace::ActivatePaneRight",
      "ctrl-w ctrl-l": "workspace::ActivatePaneRight"
    }
    // Use alt + hjkl to focus in all the editor docks
    // the terminal, project panel, assistant panel, ...) end.
  },
  {
    "context": "Terminal",
    "use_key_equivalents": true,
    "unbind": {
      "ctrl-shift-space": "terminal::ToggleViMode",
      "secondary-n": "workspace::NewTerminal",
      "cmd-k": "terminal::Clear"
    },
    "bindings": {
      "secondary-k secondary-n": "workspace::NewTerminal"
    }
  },
  {
    // Give macOS terminal mode and clearing dedicated chords.
    "context": "os == macos > Terminal",
    "use_key_equivalents": true,
    "bindings": {
      "secondary-k secondary-m": "terminal::ToggleViMode"
    }
  },
  {
    // Send Linux and Windows Ctrl keys directly to the terminal.
    "context": "(os == linux || os == windows) > Terminal",
    "use_key_equivalents": true,
    "bindings": {
      "ctrl-a": ["terminal::SendKeystroke", "ctrl-a"],
      "ctrl-b": ["terminal::SendKeystroke", "ctrl-b"],
      "ctrl-c": ["terminal::SendKeystroke", "ctrl-c"],
      "ctrl-d": ["terminal::SendKeystroke", "ctrl-d"],
      "ctrl-e": ["terminal::SendKeystroke", "ctrl-e"],
      "ctrl-f": ["terminal::SendKeystroke", "ctrl-f"],
      "ctrl-g": ["terminal::SendKeystroke", "ctrl-g"],
      "ctrl-h": ["terminal::SendKeystroke", "ctrl-h"],
      "ctrl-i": ["terminal::SendKeystroke", "ctrl-i"],
      "ctrl-j": ["terminal::SendKeystroke", "ctrl-j"],
      "ctrl-k": ["terminal::SendKeystroke", "ctrl-k"],
      "ctrl-l": ["terminal::SendKeystroke", "ctrl-l"],
      "ctrl-m": ["terminal::SendKeystroke", "ctrl-m"],
      "ctrl-n": ["terminal::SendKeystroke", "ctrl-n"],
      "ctrl-o": ["terminal::SendKeystroke", "ctrl-o"],
      "ctrl-p": ["terminal::SendKeystroke", "ctrl-p"],
      "ctrl-q": ["terminal::SendKeystroke", "ctrl-q"],
      "ctrl-r": ["terminal::SendKeystroke", "ctrl-r"],
      "ctrl-s": ["terminal::SendKeystroke", "ctrl-s"],
      "ctrl-t": ["terminal::SendKeystroke", "ctrl-t"],
      "ctrl-u": ["terminal::SendKeystroke", "ctrl-u"],
      "ctrl-v": ["terminal::SendKeystroke", "ctrl-v"],
      "ctrl-w": ["terminal::SendKeystroke", "ctrl-w"],
      "ctrl-x": ["terminal::SendKeystroke", "ctrl-x"],
      "ctrl-y": ["terminal::SendKeystroke", "ctrl-y"],
      "ctrl-z": ["terminal::SendKeystroke", "ctrl-z"],
      "secondary-k secondary-m": "terminal::ToggleViMode"
    }
  },
  {
    "context": "GitPanel && ChangesList",
    "bindings": {
      "o": "git::ViewFile"
    }
  },
  {
    // Project panel begin.
    "context": "ProjectPanel",
    "unbind": {
      "alt-shift-c": "workspace::CopyPath",
      "secondary-k secondary-shift-c": "workspace::CopyRelativePath",
      "ctrl-alt-c": "project_panel::CopyPath",
      "cmd-alt-c": "workspace::CopyPath",
      "secondary-alt-shift-c": "workspace::CopyRelativePath"
    }
  },
  {
    // Use file-tree operations while the project panel is idle.
    "context": "ProjectPanel && not_editing",
    "use_key_equivalents": true,
    "unbind": {
      "shift-5": "project_panel::NewFile",
      "d": "project_panel::NewDirectory",
      "x": "project_panel::RevealInFileManager",
      "s": "workspace::OpenWithSystem",
      "secondary-x": "project_panel::Cut",
      "space": "project_panel::Open",
      "p": "project_panel::Open",
      "t": "project_panel::OpenPermanent",
      "o": "project_panel::OpenSplitHorizontal",
      "h": "project_panel::CollapseSelectedEntry"
    },
    "bindings": {
      "a": "project_panel::NewFile",
      "shift-a": "project_panel::NewDirectory",
      "x": "project_panel::Cut",
      "y": "project_panel::Copy",
      "p": "project_panel::Paste",
      "secondary-r": "project_panel::RevealInFileManager",
      "secondary-s": "workspace::OpenWithSystem",
      "secondary-o": "project_panel::Open",
      "secondary-shift-o": "project_panel::OpenPermanent",
      "g h": "git::FileHistory",
      "h": "project_panel::OpenSplitHorizontal",
      "v": "project_panel::OpenSplitVertical"
    }
  }, // Project panel end.
  {
    "context": "OutlinePanel && not_editing",
    "unbind": {
      "alt-shift-c": "workspace::CopyPath",
      "secondary-alt-shift-c": "workspace::CopyRelativePath",
      "ctrl-alt-c": "outline_panel::CopyPath",
      "cmd-alt-c": "workspace::CopyPath"
    }
  },
  {
    // Pane begin.
    "context": "Pane",
    "unbind": {
      "secondary-k shift-enter": "pane::TogglePinTab",
      "alt-l": "search::ToggleSelection"
    }
  },
  {
    // Pin tabs with the editor prefix outside terminals.
    "context": "Pane && !Terminal",
    "use_key_equivalents": true,
    "bindings": {
      "secondary-l secondary-p": "pane::TogglePinTab"
    }
  }, // Pane end.
  {
    // Debugger begin.
    "context": "Editor",
    "bindings": {
      "alt-d e": "editor::EnableBreakpoint",
      "alt-d d": "editor::DisableBreakpoint",
      "alt-d t": "editor::ToggleBreakpoint"
    }
  },
  {
    // Control debugging sessions from the workspace.
    "context": "Workspace && !Terminal && !ProjectPanel",
    "bindings": {
      "alt-d r": "debugger::Start",
      "alt-d shift-r": "debugger::RerunSession",
      "alt-d p": "debugger::Pause",
      "alt-d shift-p": "debugger::Stop",
      "alt-d .": "debugger::RunToCursor",
      "alt-d s": "debugger::StepInto",
      "alt-d b": "debugger::StepBack",
      "alt-d n": "debugger::StepOver",
      "alt-d o": "debugger::StepOut",
      "alt-d v": "debugger::EvaluateSelectedText"
    }
  },
  {
    // Continue only when the debugger is stopped.
    "context": "Workspace && debugger_stopped && !Terminal && !ProjectPanel",
    "bindings": {
      "alt-d c": "debugger::Continue"
    }
  }, // Debugger end.
  {
    // Task begin.
    "context": "Workspace",
    "unbind": {
      "alt-shift-t": "task::Spawn",
      "alt-t": "task::Rerun",
      "alt-shift-r": [
        "task::Spawn",
        {
          "reveal_target": "center"
        }
      ],
      "secondary-shift-r": [
        "task::Rerun",
        {
          "reevaluate_context": false
        }
      ],
      "cmd-shift-r": "task::Spawn"
    }
  },
  {
    // Run tasks through Alt-T outside terminals.
    "context": "Workspace && !Terminal",
    "bindings": {
      "alt-t n": "task::Spawn",
      "alt-t r": "task::Rerun",
      "alt-t shift-n": [
        "task::Spawn",
        {
          "reveal_target": "center"
        }
      ],
      "alt-t shift-r": [
        "task::Rerun",
        {
          "reevaluate_context": false
        }
      ]
    }
  }, // Task end.
  {
    "context": "Editor",
    "unbind": {
      "ctrl-insert": "editor::Copy",
      "shift-insert": "editor::Paste"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "secondary-k secondary-i": "editor::Hover"
    },
    "bindings": {
      "secondary-l secondary-k": "editor::Hover"
    }
  },
  {
    // Bookmarks.
    "context": "Editor",
    "use_key_equivalents": true,
    "bindings": {
      "secondary-l secondary-m": "editor::ToggleBookmark",
      "secondary-l secondary-shift-m": "editor::ViewBookmarks",
      "secondary-.": "editor::GoToNextBookmark",
      "secondary-,": "editor::GoToPreviousBookmark"
    }
  },
  // Neovim bindings.
  {
    // Neovim leader: keep bare Space from moving the cursor while preserving longer chords.
    "context": "VimControl && !menu",
    "bindings": {
      "space": null
    }
  },
  {
    // Neovim Normal-mode aliases. Existing Zed bindings remain available.
    "context": "Editor && vim_mode == normal && !menu",
    "bindings": {
      // Buffers and quitting.
      "space b d": "workspace::CloseItemInAllPanes",
      "space b n": "pane::ActivateNextItem",
      "space b p": "pane::ActivatePreviousItem",
      "space b b": "pane::AlternateFile",
      "space q": "pane::CloseActiveItem",
      "space shift-q": "zed::Quit",
      // Splits and pane layout.
      "space s v": "pane::SplitVertical",
      "space s h": "pane::SplitHorizontal",
      "space s shift-h": "workspace::MovePaneLeft",
      "space s shift-j": "workspace::MovePaneDown",
      "space s shift-k": "workspace::MovePaneUp",
      "space s shift-l": "workspace::MovePaneRight",
      "space s x": "workspace::SwapPaneAdjacent",
      "space s =": "workspace::ResetPaneSizes",
      // File, search, tab, diagnostics, and help pickers.
      "space p f": "file_finder::Toggle",
      "space p g": "pane::DeploySearch",
      "space p b": "tab_switcher::OpenInActivePane",
      "space p d": "diagnostics::Deploy",
      "space p r": "workspace::ReopenLastPicker",
      "space p p": [
        "pane::DeploySearch",
        {
          "query": "\\b(FIXME|ERROR|HACK|WARN|TODO|NOTE|HINT|INFO)\\b",
          "regex": true,
          "case_sensitive": true,
          "include_ignored": false
        }
      ],
      "space p k": "zed::OpenKeymap",
      "space p h": "zed::OpenDocs",
      "space p \"": "vim::ToggleRegistersView",
      // Language symbol pickers and navigation.
      "space p l c": "editor::GoToDeclaration",
      "space p l d": "editor::GoToDefinition",
      "space p l s": "outline::Toggle",
      "space p l i": "editor::GoToImplementation",
      "space p l r": "editor::FindAllReferences",
      "space p l t": "editor::GoToTypeDefinition",
      "space p l shift-s": "project_symbols::Toggle",
      // Formatting and diagnostics.
      "space c f": "editor::Format",
      "space i s": "editor::ConvertIndentationToSpaces",
      "space i t": "editor::ConvertIndentationToTabs",
      "space e t": "editor::ToggleInlineDiagnostics",
      "space e q": "diagnostics::DeployCurrentFile",
      // Paths, settings, terminal, and workspace utilities.
      "space f p": "workspace::CopyPath",
      "space f l": "line_ending_selector::Toggle",
      "space f e": "encoding_selector::Toggle",
      "space r c": "zed::OpenSettingsFile",
      "space t f": "terminal_panel::Toggle",
      "space t t": "workspace::NewCenterTerminal",
      "space n p": "workspace::ToggleCenteredLayout",
      "space n d": "workspace::ClearAllNotifications",
      // Bookmarks as Harpoon-like navigation.
      "space h a": "editor::ToggleBookmark",
      "space h t": "editor::ViewBookmarks",
      "space h n": "editor::GoToNextBookmark",
      "space h p": "editor::GoToPreviousBookmark",
      // Project panel and replacement search.
      "space o f": "project_panel::ToggleFocus",
      "space m f": "project_panel::ToggleFocus",
      "space shift-s": ["pane::DeploySearch", { "replace_enabled": true }],
      // Git staging, diffs, and blame.
      "space g s": "git::ToggleStaged",
      "space g r": "git::Restore",
      "space g shift-s": "git::StageFile",
      "space g shift-u": "git::UnstageFile",
      "space g shift-r": "git::RestoreFile",
      "space g p": "editor::ToggleSelectedDiffHunks",
      "space g shift-p": "editor::ToggleSelectedDiffHunks",
      "space g b": "editor::BlameHover",
      "space g shift-b": "git::Blame",
      "space g d": "git::OpenFileDiff",
      "space g i b": "editor::ToggleGitBlameInline",
      "space g t": "git_panel::ToggleFocus",
      "space g shift-t": "git::ViewUncommittedChanges",
      // Debugger controls.
      "space d b": "editor::ToggleBreakpoint",
      "space d c": "debugger::Continue",
      "space d s": "debugger::StepInto",
      "space d n": "debugger::StepOver",
      "space d o": "debugger::StepOut",
      "space d shift-r": "debugger::Restart",
      "space d t": "debugger::FocusConsole",
      "space d ?": "debugger::EvaluateSelectedText",
      // Direct language navigation and split previews.
      "g i": "editor::GoToImplementation",
      "g r t": "editor::GoToTypeDefinition",
      "g p d": "editor::GoToDefinitionSplit",
      "g p y": "editor::GoToTypeDefinitionSplit",
      "g p c": "editor::GoToDeclarationSplit",
      "g p r": "editor::FindAllReferences",
      "g p i": "editor::GoToImplementationSplit",
      // Diagnostic and LSP chords.
      "] e": ["editor::GoToDiagnostic", { "severity": "error" }],
      "[ e": ["editor::GoToPreviousDiagnostic", { "severity": "error" }],
      "] w": ["editor::GoToDiagnostic", { "severity": "warning" }],
      "[ w": ["editor::GoToPreviousDiagnostic", { "severity": "warning" }],
      "ctrl-w d": "editor::GoToDiagnostic",
      "ctrl-s h": "editor::Hover",
      "ctrl-s s": "editor::ShowSignatureHelp",
      "ctrl-s r n": "editor::Rename",
      "ctrl-s i c": "call_hierarchy::ShowIncomingCalls",
      "ctrl-s o c": "call_hierarchy::ShowOutgoingCalls",
      "ctrl-s c a": "editor::ToggleCodeActions",
      "ctrl-s d s": "outline::Toggle",
      "ctrl-s d c": "editor::GoToDeclaration",
      "ctrl-s w s": "project_symbols::Toggle",
      "ctrl-s w d": "diagnostics::Deploy",
      "ctrl-s l": "editor::ToggleInlayHints",
      // Syntax selection and surround edits.
      "g n n": "editor::SelectLargerSyntaxNode",
      "space x x": "vim::Exchange",
      "s a": ["vim::PushAddSurrounds", {}],
      "s d": "vim::PushDeleteSurrounds",
      "s r": ["vim::PushChangeSurrounds", {}]
    }
  },
  {
    // Neovim Visual-mode aliases.
    "context": "Editor && vim_mode == visual && !menu",
    "bindings": {
      // Format the selection and search for replacements.
      "space c f": "editor::FormatSelections",
      "space i s": "editor::ConvertIndentationToSpaces",
      "space i t": "editor::ConvertIndentationToTabs",
      "space x x": "vim::Exchange",
      "space shift-s": ["pane::DeploySearch", { "replace_enabled": true }],
      // Stage or restore selected Git hunks.
      "space g s": "git::ToggleStaged",
      "space g r": "git::Restore",
      // Grow or shrink syntax selections.
      "g r n": "editor::SelectLargerSyntaxNode",
      "g r c": "editor::SelectLargerSyntaxNode",
      "g r m": "editor::SelectSmallerSyntaxNode",
      // Code actions for the selection.
      "ctrl-s c a": "editor::ToggleCodeActions"
    }
  }
]
