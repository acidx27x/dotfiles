{
  // connections
  "wsl_connections": [],
  "ssh_connections": [],
  "proxy": "",
  // general
  "telemetry": {
    "metrics": false,
    "diagnostics": false,
  },
  "confirm_quit": true,
  "reveal_if_open": true,
  "on_new_window": "empty_tab",
  "restore_on_startup": "empty_tab",
  "on_last_window_closed": "quit_app",
  "cli_default_open_behavior": "new_window",
  "when_closing_with_no_tabs": "close_window",
  "redact_private_values": true,
  "private_files": [
    "**/.env*",
    "**/*.pem",
    "**/*.key",
    "**/*.cert",
    "**/*.crt",
    "**/secrets.yml"
  ],
  // appearence
  "cursor_blink": false,
  "theme": "Kanagawa Dragon",
  "icon_theme": "Catppuccin Latte",
  "buffer_font_family": "Fira Code",
  "buffer_font_size": 15.5,
  "buffer_font_fallbacks": null,
  "buffer_font_features": {
    "calt": true,
    "cv01": true,
    "cv02": true,
    "cv06": true,
    "ss01": true,
    "cv13": true,
    "cv14": true,
    "ss05": true,
    "ss04": true,
    "cv18": true,
    "cv16": true,
    "cv29": true,
    "cv30": true,
    "cv28": true,
    "ss06": true,
    "ss07": true,
    "ss10": true,
  },
  "ui_font_family": "Fira Code",
  "ui_font_size": 14.5,
  "ui_font_fallbacks": null,
  "agent_ui_font_size": 13.5,
  "agent_buffer_font_size": 13.5,
  "markdown_preview": {
    "font_size": 14.5,
  },
  "git_commit_buffer_font_size": 13.5,
  "text_rendering_mode": "grayscale",
  "cursor_animation": {
    "enabled": false,
  },
  "rounded_selection": false,
  // keymap
  "vim_mode": true,
  // editor
  "vim": {
    "use_regex_search": false,
    "use_smartcase_find": true,
  },
  "tab_size": 2,
  "colorize_brackets": true,
  "always_treat_brackets_as_autoclosed": true,
  "line_ending": "prefer_lf",
  "preferred_line_length": 100,
  "vertical_scroll_margin": 5.0,
  "show_whitespaces": "boundary",
  "relative_line_numbers": "enabled",
  "which_key": {
    "enabled": true,
    "delay_ms": 1000,
  },
  "format_on_save": "off",
  "use_on_type_format": false,
  "formatter": "auto",
  "autosave": {
    "after_delay": {
      "milliseconds": 5000,
    },
  },
  "middle_click_paste": false,
  "diff_view_style": "unified",
  "gutter": {
    "runnables": false,
  },
  "toolbar": {
    "breadcrumbs": true,
    "selections_menu": false,
    "quick_actions": false,
    "code_actions": false,
  },
  "scrollbar": {
    "selected_symbol": false,
    "selected_text": false,
    "cursors": false,
    "show": "always",
    "diagnostics": "error",
  },
  "sticky_scroll": {
    "enabled": true,
  },
  "indent_guides": {
    "line_width": 1,
    "active_line_width": 2,
    "coloring": "indent_aware",
    "background_coloring": "indent_aware",
  },
  "snippet_sort_order": "bottom",
  "completions": {
    "words": "enabled",
    "words_min_length": 4,
    "lsp_insert_mode": "replace_subsequence",
  },
  "show_completions_on_input": true,
  "completion_menu_item_kind": "symbol",
  "completion_menu_scrollbar": "always",
  "show_completion_documentation": true,
  "inlay_hints": {
    "show_background": true,
    "show_value_hints": false,
    "toggle_on_modifiers_press": {
      "control": true,
      "platform": true,
    },
  },
  "code_lens": "on",
  "lsp_document_colors": "background", // need for 'color-highlight'
  "lsp_document_links": true,
  "lsp_results_location": "picker",
  // language and tools
  "prettier": {
    "allowed": true,
  },
  "go_to_definition_fallback": "none",
  "go_to_definition_scroll_strategy": "center",
  "diagnostics_max_severity": "all",
  "diagnostics": {
    "include_warnings": true,
    "inline": {
      "enabled": false,
      "max_severity": "all",
    },
  },
  // need to overwrite for specific language in the end
  "semantic_tokens": "off",
  "document_symbols": "off",
  "document_folding_ranges": "off",
  // search and files
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
  ],
  "search": {
    "search_on_type": false,
    "button": false,
    "regex": false,
    "whole_word": false,
    "include_ignored": true,
    "center_on_match": true,
  },
  "use_smartcase_search": true,
  "seed_search_query_from_cursor": "selection",
  "file_finder": {
    "include_ignored": "all",
    "modal_max_width": "medium",
  },
  // window and layout
  "centered_layout": {
    "right_padding": 0.15,
    "left_padding": 0.15,
  },
  "tabs": {
    "file_icons": true,
    "git_status": true,
    "show_diagnostics": "errors",
  },
  "title_bar": {
    "show_menus": false,
    "show_branch_status_icon": true,
  },
  "tab_bar": {
    "show_nav_history_buttons": true,
    "show_pinned_tabs_in_separate_row": true,
  },
  "status_bar": {
    "active_encoding_button": "enabled",
  },
  "preview_tabs": {
    "enabled": true,
    "enable_preview_from_file_finder": false,
    "enable_preview_from_multibuffer": true,
    "enable_preview_from_project_panel": true,
    "enable_keep_preview_on_code_navigation": true,
    "enable_preview_file_from_code_navigation": true,
    "enable_preview_multibuffer_from_code_navigation": true,
  },
  "window_title_format": "${projectName}${separator}${remoteHost}${separator}${fileName}",
  "active_pane_modifiers": {
    "border_size": 2.0,
    "inactive_opacity": 0.85,
  },
  // panels
  "git_panel": {
    "folder_indicator": "chevron",
    "dock": "right",
    "tree_view": true,
    "show_count_badge": true,
    "commit_title_max_length": 90,
    "fallback_branch_name": "master",
    "entry_primary_click_action": "file_diff",
  },
  "project_panel": {
    "folder_indicator": "chevron",
    "dock": "left",
    "diagnostic_badges": true,
    "show_diagnostics": "errors",
    "git_status_indicator": true,
  },
  "outline_panel": {
    "folder_indicator": "chevron",
    "dock": "right",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  // debugger
  "debugger": {
    "dock": "bottom",
    "save_breakpoints": true,
  },
  // terminal
  "terminal": {
    "font_size": 13.5,
    "toolbar": {
      "breadcrumbs": false,
    },
    "dock": "bottom",
    "blinking": "on",
    "option_as_meta": true,
    "copy_on_select": true,
    "show_count_badge": true,
    "keep_selection_on_copy": true,
    "env": {
      "GIT_EDITOR": "zed --wait",
    },
  },
  // vcs
  "git": {
    "worktree_directory": "..",
    "blame": {
      "show_avatar": true,
    },
    "inline_blame": {
      "enabled": false,
      "show_commit_summary": true,
    },
  },
  // collab
  "calls": {
    "mute_on_join": true,
  },
  // ai
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "collaboration_mode": "default",
        "fast-mode": false,
        "reasoning_effort": "xhigh",
      },
      "favorite_config_option_values": {
        "model": [
          "gpt-5.6"
        ],
        "mode": [
          "auto"
        ],
        "reasoning_effort": [
          "medium",
          "high"
        ],
      },
      "type": "registry",
    },
  },
  "agent": {
    "dock": "left",
    "sidebar_side": "left",
    "show_turn_stats": true,
    "play_sound_when_agent_done": "always",
    "notify_when_agent_waiting": "all_screens",
    "use_modifier_to_send": true,
    "expand_edit_card": false,
    "expand_terminal_card": false,
    "tool_permissions": {
      "default": "confirm",
      "tools": {
        "terminal": {
          "default": "allow",
        },
        "edit_file": {
          "default": "allow",
        },
        "delete_path": {
          "default": "confirm",
        },
        "copy_path": {
          "default": "allow",
        },
        "move_path": {
          "default": "confirm",
        },
        "create_directory": {
          "default": "allow",
        },
        "save_file": {
          "default": "allow",
        },
        "fetch": {
          "default": "confirm",
        },
        "search_web": {
          "default": "allow",
        },
        "restore_file_from_disk": {
          "default": "confirm",
        },
      },
    },
  },
  "edit_predictions": {
    "allow_data_collection": "no",
    "provider": "none",
    "disabled_globs": [
      "**/.git",
      "**/.svn",
      "**/.hg",
      "**/CVS",
      "**/.DS_Store",
      "**/Thumbs.db",
      "**/.classpath",
      "**/.settings",
      "**/.vscode",
      "**/.zed",
      "**/.idea",
      "**/node_modules",
      "**/build",
      "**/dist",
      "**/libs",
      "**/coverage",
      "**/.venv",
      "**/__pycache__",
    ],
  },
  // common extensions
  "auto_install_extensions": {
    "kanagawa-themes": true,
    "catppuccin-icons": true,
    "xml": true,
    "lua": true,
    "make": true,
    "toml": true,
    "scheme": true,
    "comment": true,
    "neocmake": true,
    "powershell": true,
    "dockerfile": true,
    "git-firefly": true,
    "editorconfig": true,
    "color-highlight": true,
    "tree-sitter-query": true,
  },
  // overrides
  // file types
  "file_types": {
    "C": [
      "*.h.in",
      "*.h.base"
    ],
    "C++": [
      "*.hpp.in",
      "*.hpp.base"
    ],
    "CMake": [
      "*.cmake.in",
      "*.cmake.base"
    ],
    "Python": [
      "*.py.in",
      "*.py.base"
    ],
    "Shell Script": [
      "*.sh.in",
      "*.sh.base",
      "*.bash.in",
      "*.bash.base"
    ],
    "YAML": [
      ".clangd",
      ".clang-tidy",
      ".clang-format"
    ],
  },
  // languages
  "languages": {
    "C": {
      "document_symbols": "on",
      "document_folding_ranges": "on",
      "semantic_tokens": "combined",
    },
    "C++": {
      "document_symbols": "on",
      "document_folding_ranges": "on",
      "semantic_tokens": "combined",
    },
    "JavaScript": {
      "format_on_save": "on",
      "formatter": "prettier",
    },
    "JSON": {
      "format_on_save": "on",
      "formatter": "prettier",
      // "formatter": {
      //   "language_server": {
      //     "name": "biome",
      //   },
      // },
    },
    "Python": {
      "tab_size": 4,
    },
  },
  // lsp servers
  "lsp": {
    "clangd": {
      "binary": {
        "ignore_system_version": true,
        "arguments": [
          "-j",
          "8",
          "--pretty",
          "--log=error",
          "--clang-tidy",
          "--enable-config",
          "--background-index",
          "--pch-storage=disk",
          "--header-insertion=never",
          "--completion-style=detailed",
          "--function-arg-placeholders=0",
        ],
      },
    },
  },
  // themes
  "theme_overrides": {
    "Kanagawa Dragon": {
      "vim.yank.background": "#964000",
      "editor.document_highlight.bracket_background": "#4A3A2E",
      "syntax": {
        "constant.comment.todo": {
          "color": "#4078F2FF",
          "background_color": "#00000000",
          "font_weight": 600,
          "font_style": "italic",
        },
        "string.comment.info": {
          "color": "#50A14FFF",
          "background_color": "#00000000",
          "font_weight": 600,
          "font_style": "italic",
        },
        "keyword.comment.warn": {
          "color": "#C18401FF",
          "background_color": "#00000000",
          "font_weight": 600,
          "font_style": "italic",
        },
        "property.comment.error": {
          "color": "#CA1243FF",
          "background_color": "#00000000",
          "font_weight": 600,
          "font_style": "italic",
        },
      },
    },
  },
}
