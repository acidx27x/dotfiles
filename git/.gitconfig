
[user]
  name  = kirim
  email = telegram@acidx27x


[core]
  eol      = lf
  autocrlf = false
  pager = delta
  whitespace = trailing-space,space-before-tab  # detect ws problems 'git diff --check'


[init]
  defaultBranch = master

[commit]
  verbose = true

[fetch]
  all       = true
  prune     = true  # prune to remove old remotes
  pruneTags = true

[pull]
  rebase = true

[push]
  default = simple  # feature/login -> origin/feature/login


[rebase]
  autoStash  = true
  autosquash = true
  updateRefs = true

[rerere]
  enabled    = true  # reuse recorded resolution to let git remember resolved conflicts
  autoupdate = true


[branch]
  sort = -committerdate

[tag]
  sort = version:refname


[interactive]
  diffFilter = delta --color-only --features=interactive


[delta]
  tabs = 2
  dark = true
  true-color = always
  navigate = true
  ; side-by-side = true ; do not use by default for lazygit
  line-numbers = true
  features = decorations

  syntax-theme = gruvbox-dark
  inspect-raw-lines = false

  line-numbers-plus-style = "#98BB6C"
  line-numbers-minus-style = "#E46876"
  line-numbers-zero-style = "#727169"

  plus-style = "syntax #293D32"
  minus-style = "syntax #392B30"

[delta "interactive"]
  keep-plus-minus-markers = true

[delta "decorations"]
  file-style = omit

  commit-style = raw
  commit-decoration-style = "#85A0C7 ol"

  hunk-header-style = file line-number syntax
  hunk-header-file-style = "#85A0C7"
  hunk-header-decoration-style = "#76946A box"
  hunk-header-line-number-style = "#E6C384"


[merge]
  conflictStyle = zdiff3


[diff]
  algorithm = histogram
  colorMoved = default
  renames = copies


[filter "lfs"]
  required = true
  clean   = git-lfs clean -- %f
  smudge  = git-lfs smudge -- %f
  process = git-lfs filter-process


[maintenance]
  auto = true


[status]
  short = true
  branch = true
  showStash = true

[log]
  date = iso

[help]
  autocorrect = prompt

[column]
  ui = auto

[color]
  ui = auto


[alias]
  sdiff = -c delta.side-by-side=true diff
  ddiff = -c diff.external=difft diff
  dshow = -c diff.external=difft show --ext-diff

  amend      = commit --amend --no-edit
  amend-edit = commit --amend
  fixup      = commit --fixup

  pl  = push --force-with-lease
  pli = push --force-with-lease --force-if-includes

  lg   = log --oneline --graph --decorate --all
  l    = log --oneline --decorate
  last = log -1 HEAD --stat
  who  = shortlog -sn
  stat = show --numstat
