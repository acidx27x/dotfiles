# ~/.curlrc or ~/.config/curlrc

# Don't hang forever establishing a connection
connect-timeout = 15

# Retry transient failures
retry = 3

# Do not spend forever retrying
retry-max-time = 60

# Treat HTTP 4xx/5xx as errors, but still print the response body
fail-with-body

# Prevent credentials like https://user:pass@example.com/
disallow-username-in-url

# If redirects are enabled for a request, only allow HTTP(S) targets
proto-redir = "=http,https"
