# ~/.ssh/config

Host *
    # Detect dead connections / NAT timeouts
    ServerAliveInterval 30
    ServerAliveCountMax 3

    # Learn additional host keys during key rotation
    UpdateHostKeys yes

    # Safer defaults
    ForwardAgent no
    ForwardX11 no
    ForwardX11Trusted no

    # Allow old algorithms
    PubkeyAcceptedAlgorithms +ssh-rsa
    HostkeyAlgorithms +ssh-rsa


# Linux-only configuration
Match exec "test -e /proc/sys/kernel/osrelease"
    Include ~/.ssh/config.d/linux.conf


# Reset Match condition
Match all

# Common machine/host definitions
Include ~/.ssh/config.d/*.host.conf
