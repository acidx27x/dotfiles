# ~/.ssh/config

Host *
  # Detect dead connections / NAT timeouts
  ServerAliveInterval 30
  ServerAliveCountMax 3

  # Reuse existing SSH connections
  ControlMaster auto
  ControlPath ~/.ssh/control-%C
  ControlPersist 10m

  # Learn additional host keys during key rotation
  UpdateHostKeys yes

  # Safer defaults
  ForwardAgent no
  ForwardX11 no
  ForwardX11Trusted no

# Machine local
Include ~/.ssh/config.d/*.conf
